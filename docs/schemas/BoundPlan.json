{
  "$defs": {
    "Ambiguity": {
      "additionalProperties": false,
      "properties": {
        "ambiguity_id": {
          "minLength": 1,
          "title": "Ambiguity Id",
          "type": "string"
        },
        "question": {
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "candidates": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Candidates",
          "type": "array"
        },
        "material": {
          "default": true,
          "title": "Material",
          "type": "boolean"
        },
        "resolved": {
          "default": false,
          "title": "Resolved",
          "type": "boolean"
        },
        "resolution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolution"
        }
      },
      "required": [
        "ambiguity_id",
        "question",
        "candidates"
      ],
      "title": "Ambiguity",
      "type": "object"
    },
    "Binding": {
      "additionalProperties": false,
      "properties": {
        "semantic_ref": {
          "minLength": 1,
          "title": "Semantic Ref",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/BindingStatus"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "targets": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BindingTarget"
          },
          "title": "Targets",
          "type": "array"
        }
      },
      "required": [
        "semantic_ref",
        "status",
        "confidence"
      ],
      "title": "Binding",
      "type": "object"
    },
    "BindingEvidence": {
      "additionalProperties": false,
      "properties": {
        "source_ref": {
          "minLength": 1,
          "title": "Source Ref",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "samples": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Samples",
          "type": "array"
        }
      },
      "required": [
        "source_ref",
        "reason"
      ],
      "title": "BindingEvidence",
      "type": "object"
    },
    "BindingStatus": {
      "enum": [
        "bound",
        "ambiguous",
        "missing"
      ],
      "title": "BindingStatus",
      "type": "string"
    },
    "BindingTarget": {
      "additionalProperties": false,
      "description": "一个真实来源目标；同一语义可跨文件、表或章节绑定多个目标。",
      "properties": {
        "physical_ref": {
          "minLength": 1,
          "title": "Physical Ref",
          "type": "string"
        },
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "target_kind": {
          "pattern": "^(table_column|document_section|document_element|document_table_cell)$",
          "title": "Target Kind",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/BindingEvidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "physical_ref",
        "artifact_id",
        "target_kind",
        "confidence",
        "evidence"
      ],
      "title": "BindingTarget",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "逻辑计划与真实来源结构绑定后的不可变快照。",
  "properties": {
    "spec_version": {
      "default": "2",
      "pattern": "^2$",
      "title": "Spec Version",
      "type": "string"
    },
    "bound_plan_id": {
      "minLength": 1,
      "title": "Bound Plan Id",
      "type": "string"
    },
    "logical_plan_id": {
      "minLength": 1,
      "title": "Logical Plan Id",
      "type": "string"
    },
    "logical_plan_revision": {
      "minimum": 1,
      "title": "Logical Plan Revision",
      "type": "integer"
    },
    "logical_plan_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Logical Plan Hash",
      "type": "string"
    },
    "binding_revision": {
      "default": 1,
      "minimum": 1,
      "title": "Binding Revision",
      "type": "integer"
    },
    "input_artifact_hashes": {
      "additionalProperties": {
        "type": "string"
      },
      "minProperties": 1,
      "title": "Input Artifact Hashes",
      "type": "object"
    },
    "inspection_report_hashes": {
      "additionalProperties": {
        "type": "string"
      },
      "minProperties": 1,
      "title": "Inspection Report Hashes",
      "type": "object"
    },
    "binder_version": {
      "minLength": 1,
      "title": "Binder Version",
      "type": "string"
    },
    "threshold_version": {
      "minLength": 1,
      "title": "Threshold Version",
      "type": "string"
    },
    "bindings": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Binding"
      },
      "title": "Bindings",
      "type": "array"
    },
    "unresolved_ambiguities": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Ambiguity"
      },
      "title": "Unresolved Ambiguities",
      "type": "array"
    },
    "bound_at": {
      "format": "date-time",
      "title": "Bound At",
      "type": "string"
    }
  },
  "required": [
    "bound_plan_id",
    "logical_plan_id",
    "logical_plan_revision",
    "logical_plan_hash",
    "input_artifact_hashes",
    "inspection_report_hashes",
    "binder_version",
    "threshold_version"
  ],
  "title": "BoundPlan",
  "type": "object"
}