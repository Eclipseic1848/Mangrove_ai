{
  "$defs": {
    "BoundingBox": {
      "description": "矩形坐标，坐标空间必须显式记录。",
      "properties": {
        "x0": {
          "minimum": 0,
          "title": "X0",
          "type": "number"
        },
        "y0": {
          "minimum": 0,
          "title": "Y0",
          "type": "number"
        },
        "x1": {
          "exclusiveMinimum": 0,
          "title": "X1",
          "type": "number"
        },
        "y1": {
          "exclusiveMinimum": 0,
          "title": "Y1",
          "type": "number"
        },
        "coordinate_space": {
          "description": "pdf_points、image_pixels 或 normalized_1000",
          "title": "Coordinate Space",
          "type": "string"
        }
      },
      "required": [
        "x0",
        "y0",
        "x1",
        "y1",
        "coordinate_space"
      ],
      "title": "BoundingBox",
      "type": "object"
    },
    "ElementType": {
      "enum": [
        "document",
        "page",
        "section",
        "heading",
        "paragraph",
        "list_item",
        "quote",
        "table",
        "cell",
        "image"
      ],
      "title": "ElementType",
      "type": "string"
    }
  },
  "description": "第三方解析结果进入 Mangrove 后的统一文档元素。",
  "properties": {
    "element_id": {
      "title": "Element Id",
      "type": "string"
    },
    "artifact_id": {
      "title": "Artifact Id",
      "type": "string"
    },
    "page": {
      "minimum": 1,
      "title": "Page",
      "type": "integer"
    },
    "element_type": {
      "$ref": "#/$defs/ElementType"
    },
    "text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Text"
    },
    "bbox": {
      "anyOf": [
        {
          "$ref": "#/$defs/BoundingBox"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reading_order": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reading Order"
    },
    "parent_element_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Element Id"
    },
    "extractor": {
      "title": "Extractor",
      "type": "string"
    },
    "extractor_version": {
      "title": "Extractor Version",
      "type": "string"
    },
    "confidence": {
      "default": 1.0,
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "review_required": {
      "default": false,
      "title": "Review Required",
      "type": "boolean"
    },
    "raw_result_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Raw Result Ref"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    }
  },
  "required": [
    "element_id",
    "artifact_id",
    "page",
    "element_type",
    "extractor",
    "extractor_version"
  ],
  "title": "DocumentElement",
  "type": "object"
}