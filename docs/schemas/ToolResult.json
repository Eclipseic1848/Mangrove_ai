{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "media_type",
        "sha256",
        "size_bytes"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ExecutionLedger": {
      "additionalProperties": false,
      "properties": {
        "input_records": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Records"
        },
        "output_records": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Records"
        },
        "filtered_out_records": {
          "default": 0,
          "minimum": 0,
          "title": "Filtered Out Records",
          "type": "integer"
        },
        "rejected_records": {
          "default": 0,
          "minimum": 0,
          "title": "Rejected Records",
          "type": "integer"
        },
        "input_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Bytes"
        },
        "output_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Bytes"
        }
      },
      "title": "ExecutionLedger",
      "type": "object"
    },
    "FailureKind": {
      "enum": [
        "transient",
        "tool_incompatible",
        "invalid_plan",
        "insufficient_data",
        "needs_user",
        "policy_denied",
        "resource_exhausted"
      ],
      "title": "FailureKind",
      "type": "string"
    },
    "LineageEvent": {
      "additionalProperties": false,
      "properties": {
        "event": {
          "minLength": 1,
          "title": "Event",
          "type": "string"
        },
        "input_artifact_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Input Artifact Ids",
          "type": "array"
        },
        "output_artifact_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Output Artifact Ids",
          "type": "array"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        }
      },
      "required": [
        "event"
      ],
      "title": "LineageEvent",
      "type": "object"
    },
    "ResourceUsage": {
      "additionalProperties": false,
      "properties": {
        "duration_ms": {
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "peak_memory_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Peak Memory Bytes"
        },
        "peak_gpu_memory_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Peak Gpu Memory Bytes"
        },
        "cpu_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpu Seconds"
        }
      },
      "required": [
        "duration_ms"
      ],
      "title": "ResourceUsage",
      "type": "object"
    },
    "ToolStatus": {
      "enum": [
        "succeeded",
        "partial",
        "failed",
        "needs_input"
      ],
      "title": "ToolStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "call_id": {
      "minLength": 1,
      "title": "Call Id",
      "type": "string"
    },
    "capability_id": {
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "title": "Capability Id",
      "type": "string"
    },
    "capability_version": {
      "minLength": 1,
      "title": "Capability Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ToolStatus"
    },
    "input_artifacts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Input Artifacts",
      "type": "array"
    },
    "output_artifacts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Output Artifacts",
      "type": "array"
    },
    "ledger": {
      "$ref": "#/$defs/ExecutionLedger"
    },
    "lineage": {
      "default": [],
      "items": {
        "$ref": "#/$defs/LineageEvent"
      },
      "title": "Lineage",
      "type": "array"
    },
    "facts": {
      "additionalProperties": true,
      "title": "Facts",
      "type": "object"
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "rejects": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Rejects",
      "type": "array"
    },
    "failure_kind": {
      "anyOf": [
        {
          "$ref": "#/$defs/FailureKind"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "error_message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Message"
    },
    "retryable": {
      "default": false,
      "title": "Retryable",
      "type": "boolean"
    },
    "tool_config_summary": {
      "additionalProperties": true,
      "title": "Tool Config Summary",
      "type": "object"
    },
    "resource_usage": {
      "$ref": "#/$defs/ResourceUsage"
    }
  },
  "required": [
    "call_id",
    "capability_id",
    "capability_version",
    "status",
    "resource_usage"
  ],
  "title": "ToolResult",
  "type": "object"
}