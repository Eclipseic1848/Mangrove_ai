        "delivery_formats": ["docx"],
        "content_policy": "verbatim",
        "required_concepts": ["付款", "交付", "违约责任"]
      }
    },
    {
      "case_id": "multi_document_compare",
      "objective": "对比三份合同的付款条件、交付期限和违约责任，只列出有原文证据的差异，整理成DOCX和PDF。",
      "artifact_ids": [
        "fixture_contract_a",
        "fixture_contract_b",
        "fixture_contract_c"
      ],
      "accepted_formats": ["docx", "pdf"],
      "expected": {
        "status": "ready",
        "task_family": "compare",
        "required_operations": ["compare"],
        "delivery_formats": ["docx", "pdf"],
        "content_policy": "verbatim",
        "required_concepts": ["付款", "交付", "违约责任"]
      }
    },
    {
      "case_id": "table_sort_deduplicate",
      "objective": "筛选状态为已完成的订单，每笔订单一行，只保留订单号、客户和完成日期，按完成日期降序排列，按订单号去重，输出CSV。",
      "artifact_ids": ["fixture_orders"],
      "accepted_formats": ["xlsx", "csv"],
      "expected": {
        "status": "ready",
        "task_family": "tabular_transform",
        "selection": [
          {"field": "状态", "operator": "eq", "value": "已完成"}
