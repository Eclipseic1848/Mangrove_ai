        "record_grain_required": true,
        "combine_mode": "one_table",
        "delivery_formats": ["xlsx"],
        "content_policy": "verbatim"
      }
    },
    {
      "case_id": "contract_verbatim_extract",
      "objective": "从这些合同中逐字摘录所有与付款、交付和违约责任有关的商务条款，按文件整理成Word，不要总结或改写。",
      "artifact_ids": ["fixture_contract_a", "fixture_contract_b"],
      "accepted_formats": ["docx", "pdf"],
      "expected": {
        "status": "ready",
