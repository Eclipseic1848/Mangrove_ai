 from .base_config import *
 from .db_config import *
+
+import random as _random
+
+
+# PEP 562 模块级 __getattr__：仅当属性在包命名空间中“不存在”时触发。
+# 由于 base_config 不再定义 CRAWLER_MAX_SLEEP_SEC（改为定义区间边界），
+# 各平台每次读取 config.CRAWLER_MAX_SLEEP_SEC 都会走到这里，返回区间内的随机间隔，
+# 从而把原本固定 2 秒的规律节律变成模拟真人的不规律节奏，规避频次风控。
+def __getattr__(name):
+    if name == "CRAWLER_MAX_SLEEP_SEC":
+        return _random.uniform(CRAWLER_MIN_SLEEP_SEC, CRAWLER_MAX_SLEEP_SEC_BOUND)
+    raise AttributeError(f"module {__name__!r} has no attribute {name!r}")
