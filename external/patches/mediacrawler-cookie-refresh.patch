new file mode 100644
--- /dev/null
+++ b/media_platform/xhs/session_cookies.py
@@ -0,0 +1,187 @@
+# 本补丁属于 MediaCrawler 集成，遵循该项目的 NON-COMMERCIAL LEARNING LICENSE 1.1。
+"""只在当前浏览器上下文内同步会话，不持久化或重试来源请求。"""
+import asyncio
+from http.cookiejar import Cookie, CookieJar, DefaultCookiePolicy
+from http.cookies import SimpleCookie
+import time
+import uuid
+from urllib.parse import urlsplit
+
+import httpx
+
+
+class CookieSyncError(RuntimeError):
+    """结果已返回但会话无法安全提交，必须穿透自动重试。"""
+
+
+class SessionCookies:
+    def __init__(self, page, host, domain, initial_cookie=""):
+        self.lock = asyncio.Lock()
+        self.context = getattr(page, "context", None)
+        self.origins = {self._origin(host), self._origin(domain)}
+        self.domains = {urlsplit(host).hostname, urlsplit(domain).hostname,
+                        urlsplit(domain).hostname.removeprefix("www.")}
+        self.api = self._origin(host)
+        self.www = urlsplit(domain).hostname
+        self.initial_cookie = initial_cookie
+        self.seeded = False
+        self.bootstrap = {}
+
+    @staticmethod
+    def _origin(url):
+        parts = urlsplit(url)
+        return parts.scheme, parts.hostname, parts.port
+
+    def _allowed(self, row):
+        return row["domain"].lstrip(".").lower() in self.domains
+
+    async def _rows(self):
+        if self.context is None:
+            raise CookieSyncError("session_context_missing")
+        try:
+            rows = [row for row in await self.context.cookies() if self._allowed(row)]
+        except Exception as error:
+            raise CookieSyncError("session_read_failed") from error
+        if any(row.get("partitionKey") for row in rows):
+            raise CookieSyncError("session_partition_unsupported")
+        return rows
+
+    @staticmethod
+    def _key(row):
+        return row["name"], row["domain"], row["path"]
+
+    @classmethod
+    def _state(cls, rows):
+        now = time.time()
+        return {cls._key(row): dict(row) for row in rows
+                if row.get("expires", -1) == -1 or row["expires"] > now}
+
+    @staticmethod
+    def _jar(rows):
+        jar = CookieJar(policy=DefaultCookiePolicy(strict_ns_domain=DefaultCookiePolicy.DomainStrictNonDomain))
+        for row in rows:
+            domain = row["domain"]
+            expires = row.get("expires", -1)
+            jar.set_cookie(Cookie(
+                version=0, name=row["name"], value=row["value"], port=None, port_specified=False,
+                domain=domain, domain_specified=domain.startswith("."), domain_initial_dot=domain.startswith("."),
+                path=row["path"], path_specified=True, secure=row.get("secure", False),
+                expires=None if expires == -1 else int(expires), discard=expires == -1,
+                comment=None, comment_url=None,
+                rest={"HttpOnly": row.get("httpOnly", False), "SameSite": row.get("sameSite", "Lax"),
+                      "_mangrove_original": dict(row)},
+                rfc2109=False))
+        return jar
+
+    @staticmethod
+    def header(jar, url):
+        request = httpx.Request("GET", url)
+        httpx.Cookies(jar).set_cookie_header(request)
+        return request.headers.get("Cookie", "")
+
+    async def prepare(self, url):
+        if self._origin(url) not in self.origins:
+            raise CookieSyncError("session_origin_unapproved")
+        rows = await self._rows()
+        if not self.seeded and self._origin(url) == self.api:
+            # 旧入口把选定凭据注入 www host-only；只向固定 API 补齐一次，删除后绝不重播。
+            self.seeded = True
+            initial = dict(field.strip().split("=", 1) for field in self.initial_cookie.split(";") if "=" in field)
+            present = dict(field.strip().split("=", 1) for field in self.header(self._jar(rows), url).split(";") if "=" in field)
+            additions = []
+            for row in rows:
+                if (row["domain"] == self.www and row["path"] == "/"
+                        and initial.get(row["name"]) == row["value"] and row["name"] not in present):
+                    alias = dict(row, domain=self.api[1])
+                    additions.append(alias)
+                    self.bootstrap[self._key(row)] = dict(row)
+                    self.bootstrap[self._key(alias)] = alias
+            if additions:
+                try:
+                    await self.context.add_cookies(additions)
+                except Exception as error:
+                    raise CookieSyncError("session_bootstrap_failed") from error
+                rows = await self._rows()
+        jar = self._jar(rows)
+        header = self.header(jar, url)
+        return rows, jar, header
+
+    @staticmethod
+    def _row(value):
+        if "_mangrove_original" in value._rest:
+            return dict(value._rest["_mangrove_original"])
+        rest = {key.lower(): item for key, item in value._rest.items()}
+        same_site = {"lax": "Lax", "strict": "Strict", "none": "None"}.get(str(rest.get("samesite", "Lax")).lower())
+        if same_site is None:
+            raise CookieSyncError("session_cookie_samesite_invalid")
+        return dict(name=value.name, value=value.value, domain=value.domain, path=value.path,
+                    secure=value.secure, httpOnly="httponly" in rest and rest["httponly"] is not False,
+                    sameSite=same_site, expires=value.expires if value.expires is not None else -1)
+
+    def _retire_bootstrap(self, snapshot, jar, response):
+        retired = set()
+        original = self._state(snapshot)
+        for header in response.headers.get_list("set-cookie"):
+            parsed = SimpleCookie()
+            try:
+                parsed.load(header)
+            except Exception:
+                continue
+            for name, item in parsed.items():
+                domain = item["domain"].lstrip(".").lower() or response.request.url.host
+                if domain not in self.domains or not (response.request.url.host == domain or response.request.url.host.endswith("." + domain)):
+                    continue
+                path = item["path"] if item["path"].startswith("/") else response.request.url.path.rsplit("/", 1)[0] or "/"
+                # 无效 Max-Age 等头会被标准 jar 忽略，不能据此退役可用初始凭据。
+                marker = uuid.uuid4().hex
+                probe_domain = "." + domain if item["domain"] else domain
+                probe = self._jar([dict(name=name, value=marker, domain=probe_domain, path=path, expires=-1)])
+                single = httpx.Response(200, headers={"Set-Cookie": header}, request=response.request)
+                httpx.Cookies(probe).extract_cookies(single)
+                if any(value.name == name and value.domain == probe_domain and value.path == path
+                       and value.value == marker for value in probe):
+                    continue
+                for key, row in self.bootstrap.items():
+                    host = row["domain"].lstrip(".")
+                    matches = host == domain or bool(item["domain"]) and host.endswith("." + domain)
+                    if name == row["name"] and path == row["path"] and matches and original.get(key) == row:
+                        try:
+                            jar.clear(row["domain"], row["path"], name)
+                        except KeyError:
+                            pass
+                        retired.add(key)
+        # 退役兼容影子后重用标准 jar 应用多头、到期与删除规则。
+        if retired:
+            httpx.Cookies(jar).extract_cookies(response)
+        return retired
+
+    async def commit(self, snapshot, jar, response):
+        before = self._state(snapshot)
+        retired = self._retire_bootstrap(snapshot, jar, response)
+        after = self._state([self._row(value) for value in jar])
+        changed = [row for key, row in after.items() if before.get(key) != row]
+        deleted = [dict(row, value="", expires=0) for key, row in before.items() if key not in after]
+        if not changed and not deleted:
+            for key in retired:
+                self.bootstrap.pop(key, None)
+            return
+        # 页面自身也可能轮换登录态；不允许迟到的 HTTP 响应覆盖新会话。
+        if self._state(await self._rows()) != before:
+            raise CookieSyncError("session_concurrent_change")
+        if any(not self._allowed(row) for row in changed):
+            raise CookieSyncError("session_cookie_scope_invalid")
+        try:
+            await self.context.add_cookies(changed + deleted)
+        except Exception as error:
+            raise CookieSyncError("session_write_failed") from error
+        for key in retired:
+            self.bootstrap.pop(key, None)
+
+    async def values(self, url):
+        _, jar, header = await self.prepare(url)
+        values = {}
+        for field in header.split(";"):
+            name, separator, value = field.strip().partition("=")
+            if separator:
+                values[name] = value
+        return header, values
