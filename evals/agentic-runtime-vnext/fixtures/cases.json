    {
      "case_id": "p0-02-word-clauses-to-txt",
      "goal": {
        "original_request": "识别并汇总这个 Word 里的商务条款，输出一份 TXT，不要照搬全文。",
        "source_scope": ["source-word"],
        "output_format": "txt",
        "output_file_count": 1,
        "must_include": ["费用", "服务", "验收", "保密", "知识产权", "违约"],
        "must_not_include": ["项目背景全文", "技术架构全文"]
      },
      "sources": [
        {
          "source_id": "source-word",
          "name": "项目技术要求.docx",
          "kind": "docx",
          "sha256": "fixture-p0-02-v1",
          "locators": [
            {
              "locator": "document:index",
              "title": "文档结构",
              "kind": "index",
              "content": {
                "sections": ["项目背景", "技术架构", "费用与付款", "服务期限", "验收", "保密", "知识产权", "违约责任"]
              }
            },
            {
              "locator": "document:business-clauses",
              "title": "商务条款候选段落",
              "kind": "text",
              "content": [
                {"evidence_ref": "paragraph:18", "category": "费用", "text": "合同总价按验收通过的实际工作量结算，付款周期为收到合规发票后 30 日。"},
                {"evidence_ref": "paragraph:24", "category": "服务", "text": "服务期限为合同生效之日起 12 个月，并提供工作日 5×8 小时支持。"},
                {"evidence_ref": "paragraph:31", "category": "验收", "text": "交付物通过功能、性能和文档完整性检查后方可验收。"},
                {"evidence_ref": "paragraph:38", "category": "保密", "text": "双方对履约过程中获知的未公开信息承担保密义务。"},
                {"evidence_ref": "paragraph:42", "category": "知识产权", "text": "项目定制成果的知识产权归采购方所有，通用底层组件权利仍归供应商。"},
                {"evidence_ref": "paragraph:47", "category": "违约", "text": "逾期交付的，每延迟一日按未交付部分金额的千分之一承担违约金。"}
              ]
            },
            {
              "locator": "document:irrelevant",
              "title": "非目标正文",
              "kind": "text",
              "content": "项目背景全文：本项目采用分层技术架构，以下省略大量技术说明。"
            }
          ]
        }
      ],
      "expected": {
        "filename": "商务条款汇总.txt",
        "required_read_locators": ["document:business-clauses"],
        "forbidden_read_locators": ["document:irrelevant"],
        "required_snippets": ["费用", "服务", "验收", "保密", "知识产权", "违约", "paragraph:18", "paragraph:47"],
        "forbidden_snippets": ["项目背景全文：", "以下省略大量技术说明"]
      }
    },
