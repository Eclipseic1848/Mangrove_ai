{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "g1-independent-results.v1",
  "title": "G1 独立盲集运行结果适配契约",
  "type": "object",
  "required": ["cases"],
  "properties": {
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "outcome"],
        "properties": {
          "id": {"type": "string"},
          "outcome": {"enum": ["formal_delivery", "rejected"]},
          "failure_stage": {"type": ["string", "null"]},
          "failure_code": {"type": ["string", "null"]},
          "candidate_path": {"type": ["string", "null"]},
          "formal_delivery": {
            "type": ["object", "null"],
            "properties": {
              "delivery_id": {"type": "string", "minLength": 1},
              "output_id": {"type": "string", "minLength": 1},
              "status": {"const": "delivery_published"},
              "qa_passed": {"type": "boolean"},
              "owner_id": {"type": "string"},
              "path": {"type": "string"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "size_bytes": {"type": "integer", "minimum": 1},
              "candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "verification_report_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "source_snapshot_refs": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "required": ["source_id", "sha256"],
                  "properties": {
                    "source_id": {"type": "string", "minLength": 1},
                    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
                  },
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "delivery_id",
              "output_id",
              "status",
              "qa_passed",
              "owner_id",
              "path",
              "sha256",
              "size_bytes",
              "source_snapshot_refs",
              "candidate_sha256",
              "verification_report_hash"
            ]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
