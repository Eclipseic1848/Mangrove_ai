# ============================================================
# Mangrove（红树林）—— 全网数据采集分析 Agent · 环境变量样例
# 复制为 .env 后填入真实值；.env 已被 .gitignore 忽略，切勿提交。
# 所有字段名与 src/config/settings.py 的 Settings 字段对应（不区分大小写）。
# ============================================================

# ---------- 默认模型供应商：deepseek | qwen | local ----------
LLM_DEFAULT_PROVIDER=deepseek
# 文档抽取默认模型（工作区可按任务覆盖；设置页可按用户覆盖）
# 为避免敏感文档在不知情时外发，默认仍使用本地模型。
DOCUMENT_EXTRACTION_MODEL=local::Qwen3.6-35B-A3B

# ---------- DeepSeek（公网 API，OpenAI 兼容）----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# ---------- 阿里云百炼 DashScope Qwen（OpenAI 兼容）----------
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-plus
# Qwen3 思考模型在非流式下必须设 False 才返回 content；若用非思考模型(如 qwen-plus)可留空去掉该参数
QWEN_ENABLE_THINKING=False

# ---------- 本地部署模型（沿用现有 llm_* 字段，OpenAI 兼容）----------
LLM_MODEL_NAME=Qwen3-30B-A3B
LLM_BASE_URL=http://192.168.1.20:6015/v1
LLM_API_KEY=local
# 本地 Qwen3 思考模型（vLLM/SGLang）：经 chat_template_kwargs.enable_thinking 控制思考开关。
# True=开思考（推理更强，须把 LOCAL_MAX_TOKENS 给足，否则思考耗尽输出预算返回空 content）；
# False=关思考（快、稳）；留空/None=不发该参数（用于非思考模型）。
LOCAL_ENABLE_THINKING=True
# 本地模型输出 token 上限（与全局 LLM_MAX_TOKENS 分开，避免误调超 deepseek/qwen 的输出上限）。
# 开思考时建议给足（如 32768），否则思考未结束就被截断、content 为空。
LOCAL_MAX_TOKENS=32768
# 额外本地模型（按模型分端口部署，可选）：格式 名称@URL，多个用逗号分隔；前端会多出对应选项，各走自己的端点
# 例：LOCAL_EXTRA_MODELS=Qwen3.5-35B-A3B@http://192.168.1.20:6011/v1
LOCAL_EXTRA_MODELS=

# ---------- 通用 LLM 参数 ----------
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120

# ---------- 采集引擎 ----------
# Firecrawl 自托管地址（docker compose 起服务后填写，留空则不启用 Firecrawl 采集/搜索）
FIRECRAWL_BASE_URL=
FIRECRAWL_API_KEY=
# MediaCrawler 社媒采集（抖音/小红书/微博/B站/快手）：克隆并配好后填路径，留空则不启用。
# 许可证为非商业学习用途，商业化前需替换或采购授权。安装见 external/MediaCrawler/README。
MEDIACRAWLER_PATH=
# 运行 MediaCrawler 的 Python 解释器（留空用当前解释器）
MEDIACRAWLER_PYTHON=
# MediaCrawler 按平台 Cookie 登录（登录态）：填入则该平台用 cookie 登录，留空则走扫码+会话保存。
# 取法：浏览器登录对应平台 → F12 → Network → 任一请求的请求头 Cookie: 整段复制。cookie 会过期需偶尔更新。
MC_COOKIE_DY=
MC_COOKIE_XHS=
MC_COOKIE_WB=
MC_COOKIE_BILI=
MC_COOKIE_ZHIHU=
MC_COOKIE_KS=
MC_COOKIE_TIEBA=
# MediaCrawler 代理IP池（反国内社媒风控）：优于服务端挂境外 VPN——境外 IP 反而更易触发风控，
# 且全局 VPN 会劫持本机 LAN/localhost（断本地LLM与自托管服务）。此处只给 MediaCrawler 用国内代理。
# 不启用则直连（推荐用国内服务器直连+随机间隔即可应对一般场景）。
MC_ENABLE_IP_PROXY=false
# 代理商：static（最通用，填隧道/固定代理URL）| kuaidaili（快代理）| wandouhttp（豌豆HTTP）
# 凭证获取方法见 README_AGENT.md 第 10.1 节「如何获取代理凭证」。国内用代理IP须实名认证。
MC_IP_PROXY_PROVIDER=static
MC_IP_PROXY_POOL_COUNT=2
# provider=static 时填：http://user:pwd@host:port（各家"隧道代理"单一入口自动换IP；填好可跑 scripts/check_proxy.py 自检）
MC_STATIC_PROXY_URL=
# provider=kuaidaili 时填（快代理官网 https://www.kuaidaili.com 实名→开通私密代理→订单页拿这4个参数）
MC_KDL_SECRET_ID=  # gitleaks:allow -- 空的示例字段，不是凭据
MC_KDL_SIGNATURE=
MC_KDL_USER_NAME=
MC_KDL_USER_PWD=
# provider=wandouhttp 时填（豌豆HTTP官网 https://h.wandouip.com 企业实名→个人中心/开放接口拿 app_key）
MC_WANDOU_APP_KEY=
# 京东电商评论采集（期4）：京东已对免登录请求全面风控（实测返回验证页/系统繁忙）。
# 填入浏览器登录后的整段京东 Cookie 头即可让搜索/评论接口正常返回；留空则免登录尽力而为（多被风控）。
JD_COOKIE=
# 淘宝/天猫/拼多多：默认免登录不可靠，不接管、交全网兜底；配了 Cookie 才会尝试接管。
TB_COOKIE=
PDD_COOKIE=

# ---------- VOC 分析桥接 ----------
# True：VOC 槽点分析优先走 voc_processor 引擎（依赖其本地模型 LLM_BASE_URL）；
# 失败或为 False 时回退到可切换模型(deepseek/qwen)的 LLM VOC 分析。
VOC_USE_PROCESSOR=False

# ---------- 分析模板自学习（自演进技能）----------
# True：任务走通用兜底时把报告结构沉淀到 data/templates/，下次同类任务自动复用。
# 阶段1（半自动）：前端「沉淀为模板」按钮人工确认；阶段2（全自动）：Checker 通过时自动沉淀（见下）。
TEMPLATE_LEARNING_ENABLED=True
# 模板自学习增强（草稿区/使用统计/质量门转正与淘汰/去重）：
# 新模板先存草稿(status=draft)，被复用时回写 uses 与质量均分；达标转正、过低淘汰；保存时按关键词去重。
TEMPLATE_PROMOTE_USES=3          # 草稿转正所需最少使用次数
TEMPLATE_PROMOTE_QUALITY=70      # 草稿转正所需平均质量分
TEMPLATE_RETIRE_QUALITY=50       # 达最少次数后平均分低于此则淘汰（不再被召回）
TEMPLATE_DEDUP_THRESHOLD=0.6     # 保存时关键词 Jaccard≥此值视为重复，复用旧模板不新建
# 模板 embedding 语义召回（方案A：HTTP 调 OpenAI 兼容 /embeddings）。
# 后端级联：EMBEDDING_BASE_URL（如本地 vLLM）优先，失败自动切上面的 QWEN 配置
# （DashScope text-embedding-v4，已实测 1024 维可用）备选；都不可用回退关键词匹配。
# 上 Linux 服务器只要能联网到端点即可；切端点仅改这几项。
EMBEDDING_ENABLED=False
EMBEDDING_BASE_URL=              # 例：http://192.168.1.21:8008/v1（本地 vLLM）
EMBEDDING_API_KEY=               # 本地 vLLM 填任意值，如 local
EMBEDDING_MODEL=text-embedding-v4   # 例：Qwen3-Embedding-4B
EMBEDDING_MATCH_THRESHOLD=0.5    # 余弦相似度≥此值视为语义命中（无 rerank 时生效）
# 可选精排：召回 top5 后交 reranker 裁决（vLLM Cohere 兼容 /rerank）；留空 base_url 即禁用
RERANK_BASE_URL=                 # 例：http://192.168.1.21:8012/v1
RERANK_API_KEY=                  # 本地 vLLM 填任意值，如 local
RERANK_MODEL=                    # 例：Qwen3-Reranker-8B
RERANK_MATCH_THRESHOLD=0.35      # rerank 相关性分数≥此值视为命中

# ---------- 质量评估 Checker（Phase 3，maker≠checker）----------
# True：分析后由独立视角打质量分；不达阈值时带问题清单自动重跑分析 1 次（P1-2 闭环，限 1 次防死循环）。
# 通过且走兜底时自动沉淀模板。CHECKER_RERUN_ENABLED=False 可关自动重跑（退回仅标记提示）。
CHECKER_ENABLED=True
CHECKER_PASS_THRESHOLD=70
CHECKER_RERUN_ENABLED=True

# ---------- 上下文工程（Phase 3 C，控制 token）----------
# 对话历史超过 MAX 条则把早期对话摘要、仅保留最近 KEEP 条
CONTEXT_MAX_MESSAGES=12
CONTEXT_KEEP_RECENT=6
# 各节点喂给 LLM 的截断预算（按模型上下文窗口可调）
CLEAN_MAX_ITEM_CHARS=4000
ANALYZE_MAX_BLOB_CHARS=12000
CHECKER_MAX_REPORT_CHARS=6000

# ---------- 数据库（入库目标）----------
# 入库后端：sqlite（默认，本地）| mysql（用下方 MYSQL_* 连接）
DB_BACKEND=sqlite
# 兼容旧字段；当 DB_BACKEND=sqlite 时使用
DATABASE_URL=sqlite:///./data/app.db
# DB_BACKEND=mysql 时使用以下连接（PyMySQL）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=mangrove

# ---------- 邮件连接器（期4）：报告生成后可发邮件，走 HITL 确认 ----------
# 未配 SMTP_HOST/SMTP_USER 时邮件产出不可用（产出节点会提示未配置）。
# 常见：QQ 邮箱 smtp.qq.com:465(SSL) 用授权码；Gmail smtp.gmail.com:587(STARTTLS) 用应用专用密码。
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# 发件人地址，留空则用 SMTP_USER
SMTP_FROM=
# True 用 SSL(465)；False 用 STARTTLS(587)
SMTP_USE_SSL=True

# ---------- Slack 连接器（期4）：报告推送到 Slack 频道，走 HITL 确认 ----------
# 频道由 Incoming Webhook 本身绑定；在 Slack App → Incoming Webhooks 创建后填入。留空则 Slack 产出不可用。
SLACK_WEBHOOK_URL=

# ---------- 搜索发现（关键词→真实结果链接）----------
# 「去某站搜关键词」类任务由 search 采集器负责：先检索真实链接再抓取解析。
# auto 优先级：SearXNG(自托管免费无限) → ddgs(免费) → Tavily(兜底，省额度)。
SEARCH_PROVIDER=auto
# SearXNG 自托管（推荐，免费无限、开源）：见 docker/searxng/README.md，起服务后填地址
SEARXNG_BASE_URL=
# ddgs：免密钥免费，pip install ddgs 即可（未装则退回内置正则抓取，易被反爬）
# Tavily：可选兜底，免费额度 1000/月，申请 https://app.tavily.com（留空则不用）
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
# Tavily 正文优先（auto 模式）：false=免费优先(SearXNG→DDG→Tavily兜底，推荐)；
# true=先用 Tavily 内联正文（对知乎/汽车之家等反爬站最可靠），不足再 SearXNG/DDG 发现+抓取。
SEARCH_TAVILY_FIRST=false
# AnySearch：统一实时搜索 API（anysearch.ai），16 垂直领域 + 批量搜索 + 页面提取。
# 注册 https://anysearch.com/console/api-keys；留空则不用 AnySearch。
ANYSEARCH_API_KEY=
# RSSHub 自托管（开源，把无官方 RSS 的国内站转标准 RSS）：「搜关键词」可走它轻量采集，是
# search+mediacrawler 之外第三条稳路。留空则不启用该采集器（tier 5）。
# 自托管：docker run -d -p 1200:1200 diygod/rsshub → 填 http://localhost:1200。公共实例 rsshub.app 已限流(403)。
# 路由前置条件差异大（本地实测）：百度=✅开箱即用(覆盖面最广)；什么值得买=需 RSSHub 配 SMZDM_COOKIE；
# 微博=需微博 cookie；B站视频搜索=需 chromium-bundled 镜像。失败会被采集器捕获并自动降级。
RSSHUB_BASE_URL=

# ---------- 采集反爬加固（期2，无代理）----------
# HTTP 类采集器同域名请求间隔在 [min,max] 区间随机取值，模拟真人不规律节奏；
# min<=0 关闭限速，max<=min 退化为固定间隔。与 mediacrawler 的 MC_CRAWL_*_SLEEP_SEC 策略一致。
COLLECTOR_MIN_INTERVAL_SECONDS=1.0
COLLECTOR_MAX_INTERVAL_SECONDS=3.0
# 单采集器一次最多处理条数（含 mediacrawler 帖子数）：取 min(max_items, 此值)。数据偏少调大；调大增加耗时。
COLLECTOR_MAX_ITEMS=30
COLLECTOR_ROTATE_UA=True
COLLECTOR_MAX_RETRIES=2
# scrapling 隐身兜底：Fetcher(HTTP指纹)取空/失败时，用 StealthyFetcher(Camoufox 隐身浏览器)重抓，
# 过知乎/汽车之家/Cloudflare 等强反爬站（实测可抓知乎正文）。需先跑 `scrapling install` 下载 Camoufox 内核；
# 内核不可用时自动降级回 Fetcher（首次失败后不再重试）。Camoufox 启动慢、占资源，不需要可设 False。
SCRAPLING_STEALTH_ENABLED=True
# 单采集器调用整体超时（秒）：超时视为失败并降级下一个，防止卡死冻住流水线（期4 稳定性加固）
COLLECT_TIMEOUT_SECONDS=90
# mediacrawler 走真实浏览器，耗时远超 HTTP 采集，单独设更长超时（秒）
COLLECT_TIMEOUT_MEDIACRAWLER_SECONDS=600
# mediacrawler 动态采集间隔区间（秒）：每次翻页/取笔记/取评论 sleep 从 [min,max] 随机取值，
# 模拟真人不规律节奏、规避频次风控。可接受更慢则把上限调大。
MC_CRAWL_MIN_SLEEP_SEC=2.0
MC_CRAWL_MAX_SLEEP_SEC=6.0

# ---------- 定时任务调度（期2）----------
# 启用后网关（src/api）启动时拉起后台轮询；识别到 once@/cron@ 计划的请求会安排为定时任务。
SCHEDULER_ENABLED=True
SCHEDULER_POLL_SECONDS=30
SCHEDULER_DB_PATH=data/scheduler.db
# 单定时任务执行整体超时（秒）：超时记失败、cron 下轮重试，防止卡死任务冻住调度循环（期4 稳定性加固）
SCHEDULER_TASK_TIMEOUT_SECONDS=600

# ---------- 断点续跑 checkpoint（期4 增量，默认关闭）----------
# True：给流水线挂持久化检查点（AsyncSqliteSaver），按 thread_id=task_id 落盘各节点状态；
# 任务中断后用同一 task_id 重跑即从断点恢复。需装 langgraph-checkpoint-sqlite（见 requirements）。
CHECKPOINT_ENABLED=False
CHECKPOINT_DB_PATH=data/checkpoints.sqlite

# ---------- 数据准备模式（v2，数据获取与清洗专项，2026-07-19）----------
# 6B 决策：新任务默认走 data_prep（采集->解析->清洗->质检->输出干净数据+血缘+质量报告）；
# 关闭则回退旧分析图（兼容回退）。架构与决策详见 docs/adr/ 与 plan.md。
DATA_PREP_MODE_ENABLED=True
# 原始制品保留天数（4B 决策默认 30 天可配置；过期自动清理）
DATA_PREP_RAW_RETENTION_DAYS=30
# 单任务上限（2C 规模防护；GB/千万行级需 Phase 5 外部队列+对象存储）
DATA_PREP_MAX_TASK_BYTES=524288000
DATA_PREP_MAX_TASK_RECORDS=1000000
DATA_PREP_UPLOAD_ROOT=data/uploads
DATA_PREP_MAX_UPLOAD_BYTES=524288000
DATA_PREP_PREVIEW_MAX_BYTES=10485760
DATA_PREP_PREVIEW_MAX_RECORDS=20
DATA_PREP_BATCH_RECORDS=10000
# 私网 HTTP API 主机白名单（逗号分隔）；默认空。loopback/云元数据等硬黑名单不可放行。
DATA_PREP_HTTP_PRIVATE_HOST_ALLOWLIST=

# ---------- 批次 8A 本地可观测性（可选，默认关闭）----------
# 语义 Compiler 固定关闭思考，并使用独立的有界输出和单次超时，不继承聊天任务的长思考预算。
SEMANTIC_COMPILER_TIMEOUT_SECONDS=120
SEMANTIC_COMPILER_MAX_TOKENS=8192
# 启用后只发送任务哈希、阶段、状态、重试和格式等低敏元数据，不发送正文、Prompt 或路径。
WORKSPACE_TELEMETRY_ENABLED=False
WORKSPACE_OTLP_ENDPOINT=http://127.0.0.1:6006/v1/traces

# ---------- 扫描/混合 PDF 解析（Phase 4A，MinerU 3.4.4）----------
# 当前实测 192.168.1.21:8000 的 pipeline 可返回文本、坐标和置信度。
# hybrid-auto-engine 在当前服务上初始化失败，安装完对应引擎前不要切换。
MINERU_ENABLED=True
MINERU_BASE_URL=http://192.168.1.21:8000
MINERU_BACKEND=pipeline
MINERU_TIMEOUT_SECONDS=600

# 文档解析主备链。当前 MinerU 主用；只有提供 /layout-parsing 的
# PaddleOCR-VL 完整 Pipeline 网关才能加入主备链。
DOCUMENT_PARSER_PRIMARY=mineru
DOCUMENT_PARSER_SECONDARY=paddleocr_vl
DOCUMENT_PARSER_FALLBACK_ENABLED=True
DOCUMENT_PARSER_MAX_CONCURRENCY=2
DOCUMENT_PARSER_PAGE_RETRIES=1
DOCUMENT_PARSER_RETRY_BACKOFF_SECONDS=0.5

# PaddleOCR-VL 1.6 完整产线。18080 是 VLM 子服务，不能填入 BASE_URL。
PADDLEOCR_VL_ENABLED=False
PADDLEOCR_VL_BASE_URL=http://192.168.1.21:18081
PADDLEOCR_VL_VLM_BASE_URL=http://192.168.1.21:18080/v1
PADDLEOCR_VL_ENDPOINT=/layout-parsing
PADDLEOCR_VL_MODEL_VERSION=PaddleOCR-VL-1.6-0.9B
PADDLEOCR_VL_API_KEY=
PADDLEOCR_VL_TIMEOUT_SECONDS=600

# ---------- 数据库取数（Phase 3）----------
# 批次大小/超时/资源控制
DATA_PREP_DB_BATCH_SIZE=5000
DATA_PREP_DB_QUERY_TIMEOUT_SECONDS=60
DATA_PREP_DB_CONNECT_TIMEOUT_SECONDS=10
DATA_PREP_DB_MAX_CONNECTIONS=4
DATA_PREP_DB_MAX_RETRIES=3
DATA_PREP_DB_MAX_CELL_BYTES=1048576     # 1MB；超限截断+告警
DATA_PREP_DB_MAX_SAMPLE_ROWS=20
DATA_PREP_DB_MAX_DISCOVERY_TABLES=500
# 数据库私网访问控制
DATA_PREP_DB_HOST_ALLOWLIST=             # 非空时仅放行清单（生产加固）
DATA_PREP_DB_ALLOWED_PORTS=3306,5432    # 默认仅 MySQL/PG 端口
# sqlite 源路径限制
DATA_PREP_DB_SQLITE_ROOT=data/db_sources
# 连接密码加密密钥（空则派生自 JWT_SECRET + 启动告警；务必在部署时设置）
DATA_PREP_DB_SECRET_KEY=
# 受控自定义 SQL 开关；默认关闭，首版仅提供表级抽取（UI 不提供 SQL 输入框）
DATA_PREP_DB_CUSTOM_SQL_ENABLED=False

# ---------- 服务 ----------
API_HOST=0.0.0.0
API_PORT=8088
LOG_LEVEL=INFO

# ---------- Web UI 网关（React 前端 + FastAPI 多用户登录）----------
# 新版前端：独立 React(Vite) 工程见 frontend/；后端网关 src/api（包装现有函数，核心逻辑零改动）。
# 启动网关：python -m uvicorn src.api.main:app --host 0.0.0.0 --port 8088
# 前端开发：cd frontend && npm install && npm run dev（5173，自动代理 /api 到网关）。
# 生产：cd frontend && npm run build 生成 dist，网关同源托管，仅需起网关。
# 用户/会话历史的 SQLite（与业务 app.db/scheduler.db 分开）。部署需持久化此文件。
WEBUI_DB_PATH=data/webui.db
# JWT 签名密钥：务必改成随机长串（≥32 字节），否则用开发默认值（仅本地）。
JWT_SECRET=change-me-to-a-long-random-secret-string
# 登录令牌有效期(小时)，默认 7 天。
JWT_EXPIRE_HOURS=168
# 是否允许前端自助注册账号（False 则仅管理员可建账号）。
WEBUI_ALLOW_REGISTER=True
# 允许的前端开发源（CORS），逗号分隔；生产同源托管时可忽略。
WEBUI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
